// Project Brain OS — Data Schema
// Faithful port of sqlite_store.py (SQLite + FTS5 + Knowledge Graph + Vault)
// JSON-typed fields are stored as strings and parsed in src/lib/brain/*

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String    @id
  name           String
  slug           String    @unique
  rootPath       String    @default("")
  keywords       String    @default("[]") // JSON string[]
  gitRemotes     String    @default("[]") // JSON string[]
  rollingSummary String    @default("")
  healthScore    Int? // persisted by Memory Compression Daemon
  healthGaps     String    @default("[]") // JSON HealthGap[]
  lastCompressedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  items     Item[]
  decisions Decision[]
  edges     GraphEdge[]
  vectors   ItemVector[]
  actions   Action[]
}

model Item {
  id                 String   @id
  projectId          String?
  itemType           String // note | screenshot | terminal | clip
  title              String
  rawContent         String
  structuredSummary  String   @default("")
  visualDescription  String   @default("")
  filePath           String   @default("")
  assetPath          String   @default("")
  sourceApp          String   @default("")
  sourceUrl          String   @default("")
  metadata           String   @default("{}") // JSON object
  capturedAt         DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  vector ItemVector?
  revisions ItemRevision[]
  actions  Action[]

  @@index([projectId, capturedAt])
}

// Vector sidecar (sqlite-vec pattern): one embedding per item, stored in the same SQLite db.
model ItemVector {
  id        String   @id
  itemId    String   @unique
  projectId String?
  model     String   @default("brain-hash-v1")
  dim       Int
  vector    String // base64-encoded Float32Array (L2-normalized)
  indexedAt DateTime @default(now())

  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Decision {
  id           String   @id
  projectId    String
  title        String
  decision     String
  alternatives String   @default("[]") // JSON string[]
  reasoning    String
  outcome      String   @default("Active")
  sourceItemId String?
  decidedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, decidedAt])
}

model GraphEdge {
  id           String   @id
  projectId    String?
  sourceNode   String
  targetNode   String
  relationType String // FIXED_BY | MENTIONED_IN | DECIDED_ON | RELATED_TO
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// v2.2 runtime configuration store: LLM backend overrides (provider, keys, base URLs),
// tunable dedup window, and the desktop-agent ingest token. Values are plain strings;
// secrets are masked by the settings API and never returned in plaintext.
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Enterprise phase — self-hosted credential account (bootstrap creates the owner).
// Passwords are scrypt-hashed (salt:hash, both hex); sessions are HMAC-SHA256 JWTs
// in an httpOnly cookie — no plaintext secret ever reaches the client.
model UserAccount {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String // "salt:hash" scrypt pair
  role         String   @default("owner") // owner | editor | viewer
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

// Real-time chat persistence: one thread per project (projectId null = the
// global Inbox thread). Sources JSON mirrors GroundedSource[] from grounded.ts.
model ChatMessage {
  id           String   @id
  projectId    String? // null = inbox / all-projects thread
  role         String // user | assistant
  content      String
  mode         String   @default("") // ask | synthesize
  llmUsed      Boolean  @default(false)
  grounded     Boolean  @default(false)
  sourcesJson  String   @default("[]")
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

// v2.5 — Closed-Loop Action & Fix Verification
// (detected -> suggested -> attempted -> verified | failed). An Action row is
// materialized from an item's {error, fix} diagnosis when a verification PATCH
// lands, so suggested fixes and verified resolutions are separable facts.
model Action {
  id               String    @id
  projectId        String?
  sourceItemId     String?
  errorSignature   String    @default("")
  suggestedCommand String    @default("")
  status           String    @default("suggested") // detected | suggested | attempted | verified | failed
  verificationNote String    @default("")
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  // Nullable: inbox captures (projectId null) can carry verified fixes too —
  // the lifecycle ledger must never require triage first.
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceItem Item?   @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

// v2.5 — Durable capture audit / idempotency ledger. Every accepted capture
// records one row keyed by the sanitized content hash: an identical payload
// landing again folds into the same job (attempts + 1) instead of duplicating.
model CaptureJob {
  id             String   @id
  idempotencyKey String   @unique
  payloadJson    String   @default("")
  status         String   @default("completed") // pending | processing | completed | failed
  attempts       Int      @default(1)
  lastError      String   @default("")
  resultItemId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

// v2.5 — Document version history for two-way vault editing. Every content
// change (editor PATCH or disk-sync pull) snapshots the PREVIOUS rawContent
// with its hash so edits are auditable and conflict-detectable.
model ItemRevision {
  id          String   @id
  itemId      String
  contentHash String   @default("")
  rawContent  String
  source      String   @default("editor") // editor | disk-sync
  createdAt   DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}
