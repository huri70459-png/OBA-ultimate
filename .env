# Project Brain OS — environment template (copy to .env and adjust)
# NOTE: .env is git-ignored; never commit real keys. Values here are placeholders.

# --- Required ---------------------------------------------------------------
# SQLite database file (Prisma). Create the parent dir if you move it.
DATABASE_URL="file:./db/custom.db"

# --- Optional: LLM backends (all optional — engine falls back to the
#     deterministic offline rule-synthesizer when unset; keys can also be
#     managed at runtime in Settings > LLM Backend, which overrides env) ----
# ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# GEMINI_API_KEY=""
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.1"
# LLM_TIMEOUT_SECONDS="20"

# --- Optional: desktop-agent ingest guard -----------------------------------
# When set, /api/agent/capture requires this token (Authorization: Bearer or
# X-Brain-Token). A token configured in Settings (agent_ingest_token) takes
# precedence over this env var.
# BRAIN_INGEST_TOKEN=""

# --- Optional: vision OCR model override (Settings value wins when present) -
# BRAIN_VISION_MODEL="gpt-4o-mini"
